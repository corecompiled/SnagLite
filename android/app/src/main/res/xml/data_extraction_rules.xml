<?xml version="1.0" encoding="utf-8"?>
<!--
  Backup + device-transfer exclusions for API 31 and above.
  Keep in sync with res/xml/backup_rules.xml (API 30 and below).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="yt-cookies.txt" />
        <exclude domain="root" path="app_webview" />
        <exclude domain="sharedpref" path="snaglite_yt.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="yt-cookies.txt" />
        <exclude domain="root" path="app_webview" />
        <exclude domain="sharedpref" path="snaglite_yt.xml" />
    </device-transfer>
</data-extraction-rules>
