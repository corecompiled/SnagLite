<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
      Post-splash theme, API 26-28. See values-v29/themes.xml for the DayNight
      parent used on API 29+. The window background must track dark mode or a
      cold launch flashes white before Compose paints its dark scheme; that
      comes from @color/snaglite_window_background resolving through
      values-night/colors.xml, which works on every supported API level.

      The parent is the *Light* platform theme because a fixed parent has to
      agree with the windowBackground it is paired with in this same resource
      folder, and values/colors.xml is the day-mode one (#FFFBFE). There is no
      DayNight platform parent before API 29, so night-mode correctness comes
      from the -night colour qualifier rather than from the parent. Compose
      screens take their colours from MaterialTheme and are unaffected either
      way, but YouTubeSignInActivity is a plain View hierarchy whose TextView
      and Button resolve ?android:textColorPrimary from this theme — a dark
      parent here renders them near-white on a near-white window.
    -->
    <style name="Theme.SnagLite" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/snaglite_window_background</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
    </style>

    <!--
      Launch theme, handed to the androidx SplashScreen compat layer. Applied via
      AndroidManifest; MainActivity calls installSplashScreen() before
      super.onCreate(), which swaps the window over to Theme.SnagLite.
    -->
    <style name="Theme.SnagLite.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/snaglite_splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.SnagLite</item>
    </style>

</resources>
