<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">SnagLite</string>

    <!-- Home screen -->
    <!--
      Deliberately format-neutral. The Video/Audio toggle picks the output format,
      not the input: the same page link serves both, so a label that followed the
      toggle would imply an "Audio URL" the user has to find and does not have.
    -->
    <string name="main_url_label">URL</string>
    <string name="main_format_video">Video</string>
    <string name="main_format_audio">Audio</string>
    <string name="main_download">Download</string>
    <string name="main_downloads_header">Downloads</string>
    <string name="main_clear_finished">Clear finished</string>

    <string name="main_empty_title">No downloads yet</string>
    <string name="main_empty_body">Paste a link and tap Download.</string>

    <!--
      %1$d is DownloadController.MAX_ACTIVE. Shown only while something is
      actually waiting, so the limit is explained at the moment it bites.
    -->
    <plurals name="main_queue_note">
        <item quantity="one">%1$d at a time — the rest are waiting.</item>
        <item quantity="other">%1$d at a time — the rest are waiting.</item>
    </plurals>

    <!-- Foreground-service notification -->
    <!--
      %1$d is the number of active downloads. Plural even though English does not
      distinguish these two forms in the "one" case, because most locales do.
    -->
    <plurals name="notif_title_active">
        <item quantity="one">SnagLite — downloading</item>
        <item quantity="other">SnagLite — %1$d downloading</item>
    </plurals>
    <!-- %1$d active, %2$d waiting. Used only while something is actually queued. -->
    <plurals name="notif_title_active_queued">
        <item quantity="one">SnagLite — %1$d downloading, %2$d queued</item>
        <item quantity="other">SnagLite — %1$d downloading, %2$d queued</item>
    </plurals>
    <!-- Shown for the moment between the worker taking the foreground and the first item going active. -->
    <string name="notif_title_starting">SnagLite — starting</string>
    <string name="notif_text_preparing">Preparing…</string>
    <!-- %1$s is the item title, %2$d its percentage. -->
    <string name="notif_text_progress">%1$s  %2$d%%</string>

    <!-- Content descriptions -->
    <string name="cd_settings">Settings</string>
    <string name="cd_paste">Paste</string>
</resources>
