<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>snaglite</AssemblyName>
    <RootNamespace>SnagLite</RootNamespace>
    <!-- Single source of truth for the CLI's reported version; release.yml asserts tag == "v" + Version. -->
    <Version>0.2.0</Version>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishReadyToRun>true</PublishReadyToRun>
    <TieredCompilation>true</TieredCompilation>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CliWrap" />
    <PackageReference Include="Spectre.Console" />
    <PackageReference Include="Spectre.Console.Cli" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SnagLite.Tests" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="hosts.local.txt" Condition="Exists('hosts.local.txt')" LogicalName="hosts.local.txt" />
  </ItemGroup>

</Project>
