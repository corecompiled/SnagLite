<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!--
      SnagLite.csproj is SelfContained + RID-specific for single-file publish.
      A plain test project referencing it would trip NETSDK1150; we only need
      the assembly, not a matching self-contained shape.
    -->
    <ValidateExecutableReferencesMatchSelfContained>false</ValidateExecutableReferencesMatchSelfContained>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SnagLite\SnagLite.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Platform-neutral fixtures, shared with the Android unit-test suite. -->
    <Content Include="..\fixtures\**\*.json"
             Link="fixtures\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
